{
  "name": "llm-test",
  "private": true,
  "workspaces": ["server", "web"],
  "scripts": {
    "dev:server": "npm run start:dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "build:server": "npm run build -w server",
    "build:web": "npm run build -w web",
    "typecheck": "npm run build -w server --if-present && npm run build -w web -- --mode development",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:studio": "npm run prisma:studio -w server"
  }
}
